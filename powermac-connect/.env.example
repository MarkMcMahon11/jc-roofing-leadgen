# --- Required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only - never expose; used only for Supabase Auth admin calls (invitations)
SUPABASE_SERVICE_ROLE_KEY=
# absolute URL of this app, used in emailed links
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Optional ---------------------------------------------------------------
# sign out after this many minutes without activity (default 480)
SESSION_IDLE_MINUTES=480
# outbound email; leave blank for preview mode (links shown to the sender instead)
RESEND_API_KEY=
EMAIL_FROM="PowerMac Connect <no-reply@example.com>"

# --- Later stages -----------------------------------------------------------
# Stage 6: PowerMac AI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=
# Stage 6/7: protects scheduled endpoints (retention, reminders, reports)
CRON_SECRET=
# Stage 7: messaging and accounting
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
