# Copy to .env.local for local development. Everything below is optional: the preview runs free with none of it.

# Owner dashboard sign-in (REQUIRED for /admin to work). Sign in at /admin/login with an email + this password.
# Use a long, unique password on any deployed site.
ADMIN_PASSWORD=
# Emails allowed to sign in (comma separated). The business email in lib/config.ts and the owner email saved on the
# "Quote prices" page also work, so this is optional.
OWNER_EMAIL=
# 32+ random characters used to sign the sign-in cookie. Optional: if blank, a key derived from ADMIN_PASSWORD is used
# (changing the password then signs everyone out).
SESSION_SECRET=

# Address search: leave GOOGLE_MAPS_API_KEY blank to use the free OpenStreetMap + Postcodes.io provider.
GOOGLE_MAPS_API_KEY=
# Set to 1 to demo address search with fake Dumfries addresses (offline / testing only).
PLACES_MOCK=

# Text messages (Twilio) and email (Resend). Leave blank to preview messages on the owner page instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
RESEND_FROM=

# Booking: leave BOTH blank to use the built-in booking picker.
# A Calendly scheduling link switches to the Calendly embed; the webhook (paid Calendly plan) needs the signing key.
NEXT_PUBLIC_CALENDLY_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Set to 1 on the live site so search engines may index it (previews stay hidden from Google).
ALLOW_INDEXING=

# Database (Supabase). Set BOTH to store data permanently; leave blank for local files / demo storage.
# Run docs/supabase.sql once in the Supabase SQL Editor first. Use the SECRET (service role) key, never the public one.
# The same project's Storage is also used for customer photos (see below) - no extra setup once this is set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI photo read (optional). Set to let customers add roof photos on the result screen and get an instant,
# honest read (material guess, condition, roughly how much looks affected) shown to them and the owner.
# Leave blank to still allow photo uploads (customer + owner can view them) with no AI read.
# Costs a small amount per photo analysed via the Anthropic API - see README for the current rate.
ANTHROPIC_API_KEY=

# Advanced: store data in a different folder (used by the test scripts).
DATA_DIR=

# WhatsApp assistant (see README). Leave blank for demo mode: everything works in the dashboard, nothing is sent to a phone.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_GB
# Jamie's WhatsApp number (digits with country code, or 07...). Falls back to "Your mobile" under Quote prices.
OWNER_WHATSAPP=
# Needed by the daily cron (Vercel sends it automatically as a Bearer token).
CRON_SECRET=
# Default is claude-sonnet-5-5; claude-opus-5-5 is the most capable.
ASSISTANT_MODEL=
ASSISTANT_DAILY_AI_CAP=300
SITE_URL=https://www.jcroofingdumfries.com
